#!/usr/bin/env bash
# ChitSmart pre-push quality gate
# Enable: git config core.hooksPath .githooks
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Determine which files changed between local HEAD and what's on the remote.
# Falls back to comparing against origin/HEAD if no remote ref is provided.
remote="$1"
url="$2"

CHANGED_FILES=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue  # branch deletion — skip
  fi
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch — compare against default branch base
    BASE=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD origin/develop 2>/dev/null || echo "")
    if [ -n "$BASE" ]; then
      CHANGED_FILES=$(git diff --name-only "$BASE" HEAD)
    else
      CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || git ls-files)
    fi
  else
    CHANGED_FILES=$(git diff --name-only "$remote_sha" "$local_sha")
  fi
done

if [ -z "$CHANGED_FILES" ]; then
  CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || git ls-files)
fi

ADMIN_CHANGED=false
BACKEND_CHANGED=false
ANDROID_CHANGED=false

while IFS= read -r f; do
  case "$f" in
    admin/*) ADMIN_CHANGED=true ;;
    backend/*) BACKEND_CHANGED=true ;;
    app/*|*.gradle|*.gradle.kts|gradle/*|gradlew|gradlew.bat) ANDROID_CHANGED=true ;;
  esac
done <<< "$CHANGED_FILES"

FAILED=false

# ─── Admin checks ────────────────────────────────────────────────────────────
if [ "$ADMIN_CHANGED" = true ]; then
  echo -e "${YELLOW}▶ Admin layer changed — running quality checks...${NC}"
  cd "$REPO_ROOT/admin"
  if ! npm run check; then
    echo -e ""
    echo -e "${RED}✗ Admin quality checks FAILED.${NC}"
    echo -e "  Fix: cd admin && npm run lint   # check ESLint errors"
    echo -e "       cd admin && npm run type-check  # check TypeScript errors"
    echo -e "       cd admin && npm run test   # check failing tests"
    echo -e "       cd admin && npm run build  # check build errors"
    FAILED=true
  fi
  cd "$REPO_ROOT"
fi

# ─── Backend checks ───────────────────────────────────────────────────────────
if [ "$BACKEND_CHANGED" = true ]; then
  echo -e "${YELLOW}▶ Backend layer changed — running quality checks...${NC}"
  cd "$REPO_ROOT/backend"
  if ! ruff check .; then
    echo -e ""
    echo -e "${RED}✗ Backend ruff lint FAILED.${NC}"
    echo -e "  Fix: cd backend && ruff check . --fix"
    FAILED=true
  fi
  if [ "$FAILED" = false ]; then
    echo -e "  ${YELLOW}Note: pytest requires a live PostgreSQL database."
    echo -e "  Running pytest if DATABASE_URL is set...${NC}"
    if [ -n "${DATABASE_URL:-}" ]; then
      if ! pytest tests/ -v --asyncio-mode=auto -x; then
        echo -e ""
        echo -e "${RED}✗ Backend pytest FAILED.${NC}"
        echo -e "  Fix: cd backend && pytest tests/ -v --asyncio-mode=auto -x"
        FAILED=true
      fi
    else
      echo -e "  ${YELLOW}⚠ DATABASE_URL not set — skipping pytest. Set it to run DB tests locally.${NC}"
    fi
  fi
  cd "$REPO_ROOT"
fi

# ─── Android warning ─────────────────────────────────────────────────────────
if [ "$ANDROID_CHANGED" = true ]; then
  echo -e "${YELLOW}⚠ Android layer changed.${NC}"
  echo -e "  Gradle is not run in the pre-push hook (too slow for interactive use)."
  echo -e "  Ensure you have run: ./gradlew lint testDebugUnitTest"
  echo -e "  These checks run automatically in GitHub Actions CI."
fi

# ─── Result ───────────────────────────────────────────────────────────────────
if [ "$FAILED" = true ]; then
  echo -e ""
  echo -e "${RED}✗ Pre-push quality gate FAILED. Push blocked.${NC}"
  exit 1
fi

echo -e "${GREEN}✓ All quality checks passed. Proceeding with push.${NC}"
exit 0
