+@Composable
+private fun OTPInputRow(
+    otp: String,
+    hasError: Boolean,
+    onOtpChange: (String) -> Unit,
+) {
+    val focusRequester = remember { FocusRequester() }
+
+    LaunchedEffect(Unit) { focusRequester.requestFocus() }
+
+    Box(modifier = Modifier.fillMaxWidth()) {
+        // Hidden actual text field
+        BasicTextField(
+            value = TextFieldValue(otp, selection = TextRange(otp.length)),
+            onValueChange = { onOtpChange(it.text) },
+            modifier = Modifier
+                .size(1.dp)
+                .focusRequester(focusRequester),
+            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword),
+            cursorBrush = SolidColor(Color.Transparent),
+        )
+
+        // Visual digit boxes
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+        ) {
+            for (i in 0..5) {
+                val char = otp.getOrNull(i)
+                val isActive = otp.length == i
+                val isFilled = char != null
+                val isError = hasError
+
+                Box(
+                    modifier = Modifier
+                        .weight(1f)
+                        .height(56.dp)
+                        .clip(RoundedCornerShape(12.dp))
+                        .background(
+                            when {
+                                isError && isFilled -> Color(0xFFFFDAD6).copy(alpha = 0.7f)
+                                isFilled -> DigitFilled
+                                else -> DigitEmpty
+                            }
+                        )
+                        .border(
+                            width = if (isActive) 2.dp else 1.dp,
+                            color = when {
+                                isError && isFilled -> ErrorBody
+                                isActive -> TealCursor
+                                else -> DigitBorder
+                            },
+                            shape = RoundedCornerShape(12.dp),
+                        )
+                        .clickable { focusRequester.requestFocus() },
+                    contentAlignment = Alignment.Center,
+                ) {
+                    if (isActive && !isFilled) {
+                        // Blinking cursor
+                        BlinkingCursor()
+                    } else if (char != null) {
+                        Text(
+                            char.toString(),
+                            fontSize = 32.sp,
+                            fontWeight = FontWeight.Bold,
+                            color = if (isError) ErrorTitle else NavyButton,
+                            letterSpacing = (-0.32).sp,
+                        )
+                    } else {
+                        // Unfilled dot
+                        Box(
+                            modifier = Modifier
+                                .size(8.dp)
+                                .clip(CircleShape)
+                                .background(SlateHint.copy(alpha = 0.4f)),
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
