<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config
    - Production: HTTPS only (default, no cleartext).
    - Debug / local builds: cleartext HTTP allowed to 10.0.2.2 (Android emulator
      loopback to host machine) so the app can reach the local FastAPI dev server.
      This domain entry is inside <debug-overrides> so it is stripped from release builds.
-->
<network-security-config>

    <!-- Base config: trust system CAs, no cleartext in production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug overrides: allow HTTP to the emulator host (10.0.2.2) only -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
        <domain-config cleartextTrafficPermitted="true">
            <!-- 10.0.2.2 maps to host machine localhost inside the Android emulator -->
            <domain includeSubdomains="false">10.0.2.2</domain>
        </domain-config>
    </debug-overrides>

</network-security-config>
