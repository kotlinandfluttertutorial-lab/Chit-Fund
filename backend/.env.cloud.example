# =============================================================================
# .env.cloud.example — CLOUD / PRODUCTION variant
#
# Do NOT use a .env file in production.
# Set these as environment variables in your cloud provider:
#   • Google Cloud Run → Secret Manager + env vars
#   • AWS ECS           → Secrets Manager + task definition env
#   • Railway / Render  → Dashboard env vars
#   • Kubernetes        → ConfigMap + Secret
#
# This file exists only as documentation / reference.
# =============================================================================

ENV=cloud
APP_NAME=ChitSmart API
APP_VERSION=0.1.0
DEBUG=false

# Managed PostgreSQL — Cloud SQL, RDS, Supabase, etc.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/chitsmart_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Security — use a strong secret; rotate periodically
SECRET_KEY=GENERATE_WITH_secrets_token_hex_32
REFRESH_TOKEN_EXPIRE_DAYS=30

# Firebase — supply the full JSON string; no file on disk in cloud
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# OpenAI
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o

# Payment gateway (use live keys in production)
PAYMENT_KEY_ID=rzp_live_REPLACE_ME
PAYMENT_KEY_SECRET=REPLACE_ME

# CORS — your production admin domain
ALLOWED_ORIGINS=https://admin.yourdomain.com

# File storage — S3-compatible bucket
STORAGE_BACKEND=s3
AWS_BUCKET_NAME=chitsmart-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# Uvicorn workers (set to 2× vCPU count)
WEB_CONCURRENCY=4
