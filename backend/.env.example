# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

APP_NAME=ChitSmart API
APP_VERSION=0.1.0
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://chitsmart:password@localhost:5432/chitsmart_dev

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY

# OTP
OTP_EXPIRE_MINUTES=10

# SMS (replace with real credentials)
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_SENDER_ID=CHTSMT

# OpenAI
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o

# Payment gateway (Razorpay)
PAYMENT_KEY_ID=rzp_test_REPLACE_ME
PAYMENT_KEY_SECRET=REPLACE_ME

# CORS — admin dashboard dev server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
