# =============================================================================
# .env.local.example — LOCAL DOCKER variant
# Copy to .env.local: cp .env.local.example .env.local
# NEVER commit .env.local to git.
# =============================================================================

ENV=local
APP_NAME=ChitSmart API
APP_VERSION=0.1.0
DEBUG=true

# Local PostgreSQL container (matches docker-compose.yml service)
DATABASE_URL=postgresql+asyncpg://chitsmart:password@db:5432/chitsmart_dev

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY
REFRESH_TOKEN_EXPIRE_DAYS=30

# Firebase — path to local service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# OpenAI
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o

# Payment gateway (use test keys locally)
PAYMENT_KEY_ID=rzp_test_REPLACE_ME
PAYMENT_KEY_SECRET=REPLACE_ME

# CORS — admin dashboard dev server + any local ports you need
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File storage — local filesystem inside the container
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
